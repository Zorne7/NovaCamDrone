<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/colorBlack"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_normal"
        android:textColor="@color/text_white"
        android:gravity="center"
        android:id="@+id/dialog_select_language_title"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/select_language"/>
    <View
        android:background="@color/text_white"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioGroup
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_english"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_english"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_german"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_german"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_french"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_french"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_portuguese"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_portuguese"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_spanish"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_spanish"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_bulgarian"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_bulgarian"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_polish"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_polish"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_dutch"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_dutch"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_czech"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_czech"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_croatian"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_croatian"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_romanian"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_romanian"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_slovak"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_slovak"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_slovenian"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_slovenian"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_greek"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_greek"
                android:buttonTint="@color/text_white"/>
            <RadioButton
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_white"
                android:id="@+id/dialog_select_language_italian"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_italian"
                android:buttonTint="@color/text_white"/>
        </RadioGroup>
    </ScrollView>
</LinearLayout>
